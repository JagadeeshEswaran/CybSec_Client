{
	"name": "CybSec-UI",
	"private": true,
	"workspaces": [
		"apps/host",
		"apps/dashboard",
		"apps/threat-feeds",
		"apps/threat-catalog",
		"apps/vulnerability-tracker",
		"packages/shared/profile"
	],
	"scripts": {
		"dev:host": "npm run dev --prefix apps/host",
		"dev:dashboard": "npm run dev --prefix apps/dashboard",
		"dev:catalog": "npm run dev --prefix apps/threat-catalog",
		"dev:tracker": "npm run dev --prefix apps/vulnerability-tracker",
		"dev:feeds": "npm run dev --prefix apps/threat-feeds",
		"start:all": "concurrently \"npm run dev:dashboard\" \"npm run dev:catalog\" \"npm run dev:tracker\" \"npm run dev:feeds\" \"npm run dev:host\"",
		"build:host": "npm run build --prefix apps/host",
		"build:mfe1": "npm run build --prefix apps/dashboard",
		"build:mfe2": "npm run build --prefix apps/threat-feeds",
		"build:mfe3": "npm run build --prefix apps/threat-catalog",
		"build:mfe4": "npm run build --prefix apps/vulnerability-tracker",
		"build:all": "npm run build:mfe1 && npm run build:mfe2 && npm run build:mfe3 && npm run build:mfe4 && npm run build:host"
	},
	"devDependencies": {
		"concurrently": "^9.0.0"
	}
}
